node {
    properties[(
        parameters[(
            choice(
                name: 'TEST_FILE',
                choices:[
                'tests/calculator.spec.ts'
                ],
            decription : 'Select the playwright test to run'
            )
        )]
    )]

    stage('Checkout') {
        git branch: 'master',
           url: 'https://github.com/brahmajiv7-web/playwright-test_jenkins.git'
    }

    stage('Install dependencies') {
        bat 'npm ci'
    }

    stage('Run Playwright tests') {
        bat 'npx playwright test ${params.TEST_FILE}' 
    }
    stage('Publish Playwright HTML Report') {
        publishHTML([
            allowMissing: false,
            alwaysLinkToLastBuild: true,
            keepAll: true,
            reportDir: 'playwright-report',
            reportFiles: 'index.html',
            reportName: 'Playwright HTML Report'
        ])
    }
}